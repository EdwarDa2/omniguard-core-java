# ============================================================
# OmniGuard Core API - Variables de Entorno de Ejemplo
# Copiar este archivo a .env y ajustar según el entorno
# ============================================================

# ------------------------------------------------------------
# Perfil y Puertos del Servidor
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081

# ------------------------------------------------------------
# Base de Datos PostgreSQL
# En desarrollo local: localhost:5432
# En red interna Docker: postgres:5432
# ------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/omniguard
SPRING_DATASOURCE_USERNAME=omniguard
SPRING_DATASOURCE_PASSWORD=omniguard_dev_edwarda2

# ------------------------------------------------------------
# Redis (Bus de Eventos y Cache)
# En desarrollo local: localhost:6379
# En red interna Docker: redis:6379
# ------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
REDIS_CHANNEL_NETWORK_EVENTS=network_events
REDIS_CHANNEL_SCAN_COMMANDS=scan_commands_channel

# ------------------------------------------------------------
# Autenticación PASETO v4
# ------------------------------------------------------------
PASETO_ACCESS_TOKEN_TTL_MINUTES=15
PASETO_REFRESH_TOKEN_TTL_DAYS=30
# Clave simétrica de 32 bytes codificada en Base64 para v4.local (Access Tokens)
PASETO_LOCAL_KEY=dGhpc2lzYTMyYnl0ZXNlY3JldGtleWZvcnBhc2V0b3Y0IQ==
# Par de claves asimétricas Ed25519 en Base64 para v4.public (Refresh Tokens)
PASETO_PUBLIC_KEY=
PASETO_PRIVATE_KEY=

# ------------------------------------------------------------
# Seguridad M2M (Python Analyzer ➔ Core Java)
# Cabecera esperada en /api/v1/internal/**: X-Internal-Token
# ------------------------------------------------------------
INTERNAL_API_TOKEN=omniguard_m2m_secret_token_dev_2026

# ------------------------------------------------------------
# Credenciales del Administrador Inicial (Data Initializer)
# ------------------------------------------------------------
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@omniguard.local
ADMIN_INITIAL_PASSWORD=OmniGuardAdmin2026!

# ------------------------------------------------------------
# CORS y Dominio de la Aplicación Frontend
# ------------------------------------------------------------
APP_DOMAIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
